<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="860.0" prefWidth="1160.0" spacing="10.0"
      style="-fx-background-color: #f8fafc; -fx-font-family: 'Segoe UI', 'Tahoma', sans-serif;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.badminton.controller.MainBillingController">

    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <!-- Top Header Bar with Role Switcher -->
    <HBox alignment="CENTER_LEFT" spacing="15.0"
          style="-fx-background-color: #1e293b; -fx-background-radius: 8; -fx-padding: 12 20 12 20;">
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"
               text="🏸 ระบบจัดการสนามแบดมินตัน &amp; จุดคิดเงิน" />
        
        <Region HBox.hgrow="ALWAYS" />

        <!-- User Role Switcher -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Label style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px;" text="ผู้ใช้ระบบ:" />
            <ComboBox fx:id="activeUserComboBox" prefWidth="250.0" />
            <Label fx:id="userRoleBadgeLabel" text="[ STAFF ]" />
        </HBox>
    </HBox>

    <!-- Sub-header Permission Banner -->
    <HBox alignment="CENTER_LEFT" spacing="10.0"
          style="-fx-background-color: #e2e8f0; -fx-background-radius: 6; -fx-padding: 6 15 6 15;">
        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="สถานะสิทธิ์ใช้งาน:" />
        <Label fx:id="userPermissionLabel" style="-fx-font-size: 12px; -fx-text-fill: #475569;"
               text="สิทธิ์: พนักงานแคชเชียร์ (สมัครสมาชิก, บันทึกการจอง, ออกบิล)" />
        <Region HBox.hgrow="ALWAYS" />
        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px;"
               text="เปิดบริการ: วันธรรมดา 13:00-21:00 / เสาร์-อาทิตย์ 10:00-20:00" />
    </HBox>

    <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
             style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">

        <!-- ======================================================== -->
        <!-- TAB 1: บันทึกการจองและคิดเงิน -->
        <!-- ======================================================== -->
        <Tab fx:id="billingTab" text=" 💳 ระบบคิดเงิน &amp; จองสนาม ">
            <HBox spacing="15.0" style="-fx-padding: 15;">

                <!-- LEFT COLUMN: ฟอร์มเลือกข้อมูล -->
                <VBox prefWidth="480.0" spacing="12.0">

                    <!-- การเลือกสมาชิก -->
                    <TitledPane animated="false" collapsible="false" text="👤 ข้อมูลสมาชิกผู้ใช้บริการ (Member)">
                        <VBox spacing="8.0">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label prefWidth="90.0" text="เลือกรหัสสมาชิก:" />
                                <ComboBox fx:id="memberComboBox" prefWidth="250.0" promptText="-- เลือกสมาชิก --" />
                            </HBox>
                            <Label fx:id="memberInfoLabel"
                                   style="-fx-font-size: 12px; -fx-text-fill: #0369a1; -fx-font-weight: bold;"
                                   text="รหัส: - | สะสม: 0 ชม." />
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;"
                                   text="* สมาชิกที่จองครบ 19 ชม. ชั่วโมงที่ 20 จะคิดค่าเช่าเพียง 70% (ลดราคา 30%)" />
                        </VBox>
                    </TitledPane>

                    <!-- การจองสนาม (เลือกหรือไม่เลือกก็ได้) -->
                    <TitledPane animated="false" collapsible="false" text="🏟️ การจองสนามแบดมินตัน (180 บาท/ชม.)">
                        <VBox spacing="8.0">
                            <CheckBox fx:id="courtBookingCheckBox" selected="true"
                                      style="-fx-font-weight: bold; -fx-text-fill: #0f172a;"
                                      text="เช่าสนามแบดมินตัน (ติ๊กออกได้ หากซื้อเฉพาะสินค้า)" />

                            <CheckBox fx:id="usePackageHoursCheckBox"
                                      text="🎟️ ใช้สิทธิ์หักชั่วโมงจากแพ็กเกจเหมาจ่าย (โควตาคงเหลือ: 0 ชม.)"
                                      style="-fx-text-fill: #1d4ed8; -fx-font-weight: bold; -fx-font-size: 11px;" />

                            <GridPane hgap="10.0" vgap="8.0">
                                <columnConstraints>
                                    <ColumnConstraints prefWidth="110.0" />
                                    <ColumnConstraints prefWidth="280.0" />
                                </columnConstraints>

                                <Label text="หมายเลขสนาม:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                <ComboBox fx:id="courtNumberComboBox" prefWidth="160.0" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                                <Label text="วันที่ต้องการจอง:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                <DatePicker fx:id="bookingDatePicker" prefWidth="160.0" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                                <Label text="ช่วงเวลาเริ่มต้น:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                                <ComboBox fx:id="timeSlotComboBox" prefWidth="200.0" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                                <Label text="จำนวนชั่วโมง:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                                <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.rowIndex="3" GridPane.columnIndex="1">
                                    <Spinner fx:id="hoursSpinner" prefWidth="90.0" />
                                    <Label text="ชั่วโมง" />
                                </HBox>
                            </GridPane>

                            <Label fx:id="discountNoticeLabel"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold;"
                                   text="สถานะส่วนลดชั่วโมงที่ 20" wrapText="true" />
                        </VBox>
                    </TitledPane>

                    <!-- การเช่าอุปกรณ์ (เลือกหรือไม่เลือกก็ได้) -->
                    <TitledPane animated="false" collapsible="false" text="👟 เช่าอุปกรณ์ (คู่/อันละ 50 บาท ต่อครั้ง/วัน)">
                        <VBox spacing="8.0">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <CheckBox fx:id="rentShoesCheckBox" prefWidth="150.0" text="เช่ารองเท้า (50 บ./คู่)" />
                                <Label text="จำนวนคู่:" />
                                <Spinner fx:id="shoesQtySpinner" prefWidth="90.0" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <CheckBox fx:id="rentRacketCheckBox" prefWidth="150.0" text="เช่าไม้แบด (50 บ./ไม้)" />
                                <Label text="จำนวนไม้:" />
                                <Spinner fx:id="racketQtySpinner" prefWidth="90.0" />
                            </HBox>
                        </VBox>
                    </TitledPane>

                    <!-- ซื้อสินค้าหน้าร้าน (เลือกหรือไม่เลือกก็ได้) -->
                    <TitledPane animated="false" collapsible="false" text="🛒 ซื้อสินค้าหน้าร้าน (ลูกขนไก่, ไม้แบด, เทป, น้ำดื่ม)">
                        <VBox spacing="8.0">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <ComboBox fx:id="productComboBox" prefWidth="220.0" promptText="-- เลือกสินค้า --" />
                                <Spinner fx:id="productQtySpinner" prefWidth="75.0" />
                                <Button fx:id="addProductButton"
                                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"
                                        text="+ เพิ่มลงบิล" />
                            </HBox>
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;"
                                   text="* ลูกค้าสามารถเลือกซื้อสินค้าได้โดยไม่จำเป็นต้องเช่าสนาม" />
                        </VBox>
                    </TitledPane>

                </VBox>

                <!-- RIGHT COLUMN: ตารางรายการบิล ยอดเงิน และแนบสลิป -->
                <VBox spacing="12.0" HBox.hgrow="ALWAYS">

                    <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"
                           text="🧾 รายการสินค้าและบริการในบิล (Live Bill Breakdown)" />

                    <!-- ตารางแสดงรายการ -->
                    <TableView fx:id="billItemTableView" prefHeight="240.0" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colType" prefWidth="90.0" text="ประเภท" />
                            <TableColumn fx:id="colName" prefWidth="160.0" text="รายการ" />
                            <TableColumn fx:id="colQty" prefWidth="60.0" text="จำนวน" />
                            <TableColumn fx:id="colUnitPrice" prefWidth="90.0" text="ราคา/หน่วย" />
                            <TableColumn fx:id="colTotal" prefWidth="90.0" text="รวม (บาท)" />
                            <TableColumn fx:id="colDetails" prefWidth="200.0" text="รายละเอียด / หมายเหตุ" />
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Button onAction="#onRemoveSelectedItem"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 11px;"
                                text="🗑️ ลบรายการที่เลือก" />
                    </HBox>

                    <!-- การแนบสลิปโอนเงิน -->
                    <TitledPane animated="false" collapsible="false" text="📎 แนบสลิปหลักฐานการชำระเงิน">
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Button fx:id="attachSlipButton" onAction="#onAttachSlip"
                                            style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold;"
                                            text="📁 เลือกไฟล์รูปสลิป (Upload Slip)" />
                                    <Label fx:id="slipPathLabel" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"
                                           text="ยังไม่ได้แนบสลิป" />
                                </HBox>
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"
                                       text="รองรับไฟล์ภาพ JPG, PNG (จะถูกบันทึกและตรวจสอบได้ในประวัติบิล)" />
                            </VBox>
                            <StackPane prefHeight="70.0" prefWidth="80.0"
                                       style="-fx-border-color: #cbd5e1; -fx-border-style: dashed; -fx-background-color: #f1f5f9;">
                                <ImageView fx:id="slipPreviewImageView" fitHeight="65.0" fitWidth="75.0"
                                           preserveRatio="true" />
                            </StackPane>
                        </HBox>
                    </TitledPane>

                    <!-- การสรุปยอดเงิน -->
                    <VBox spacing="6.0"
                          style="-fx-background-color: #f1f5f9; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="ค่าเช่าสนาม:" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="courtSubtotalLabel" style="-fx-font-weight: bold;" text="0.00 บาท" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="ค่าเช่าอุปกรณ์ (รองเท้า/ไม้แบด):" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="rentalSubtotalLabel" style="-fx-font-weight: bold;" text="0.00 บาท" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="ค่าสินค้าที่ซื้อ:" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="productSubtotalLabel" style="-fx-font-weight: bold;" text="0.00 บาท" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-text-fill: #16a34a; -fx-font-weight: bold;"
                                   text="ส่วนลดพิเศษ (ชั่วโมงที่ 20 ลด 30%):" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="discountAmountLabel"
                                   style="-fx-text-fill: #16a34a; -fx-font-weight: bold;" text="-0.00 บาท" />
                        </HBox>
                        <Separator />
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"
                                   text="ยอดรวมทั้งสิ้น (Grand Total):" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="grandTotalLabel"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"
                                   text="0.00 บาท" />
                        </HBox>
                    </VBox>

                    <!-- ปุ่มควบคุมหลัก -->
                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <Button fx:id="clearFormButton" onAction="#onClearForm" prefHeight="40.0" prefWidth="110.0"
                                style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold;"
                                text="🔄 ล้างข้อมูล" />
                        <Button fx:id="confirmCheckoutButton" onAction="#onConfirmCheckout" prefHeight="40.0" prefWidth="200.0"
                                style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"
                                text="💰 บันทึกชำระเงิน &amp; ออกบิล" />
                    </HBox>

                </VBox>

            </HBox>
        </Tab>

        <!-- ======================================================== -->
        <!-- TAB 2: ระบบสมัครและจัดการสมาชิก (Member Management) -->
        <!-- ======================================================== -->
        <Tab fx:id="memberTab" text=" 👥 ระบบสมัคร &amp; จัดการสมาชิก ">
            <HBox spacing="15.0" style="-fx-padding: 15;">

                <!-- ซ้าย: ฟอร์มสมัครสมาชิกใหม่ -->
                <VBox prefWidth="380.0" spacing="12.0">
                    <TitledPane animated="false" collapsible="false" text="📝 สมัครสมาชิกใหม่ (New Registration)">
                        <VBox spacing="10.0">
                            <Label text="รหัสสมาชิก (อัตโนมัติ):" style="-fx-font-weight: bold;" />
                            <TextField fx:id="regMemberIdTextField" editable="false" style="-fx-background-color: #f1f5f9;" />

                            <Label text="ชื่อ - นามสกุล:" style="-fx-font-weight: bold;" />
                            <TextField fx:id="regMemberNameTextField" promptText="เช่น สมชาย สายตบ" />

                            <Label text="เบอร์โทรศัพท์:" style="-fx-font-weight: bold;" />
                            <TextField fx:id="regMemberPhoneTextField" promptText="เช่น 081-234-5678" />

                            <Separator />
                            <CheckBox fx:id="regBuyPackageCheckBox"
                                      text="ซื้อแพ็กเกจเหมาจ่าย 15 ชั่วโมงทันที (2,600 บาท)"
                                      style="-fx-font-weight: bold; -fx-text-fill: #1d4ed8;" />
                            <Label text="* ได้รับโควตา 15 ชั่วโมง ประหยัดกว่าราคาปกติ 100 บาท"
                                   style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />

                            <Separator />
                            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                                <Button onAction="#onClearRegistrationForm" text="ล้างฟอร์ม"
                                        style="-fx-background-color: #64748b; -fx-text-fill: white;" />
                                <Button onAction="#onRegisterNewMember" text="💾 ยืนยันสมัครสมาชิก"
                                        style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold;" />
                            </HBox>
                        </VBox>
                    </TitledPane>

                    <VBox spacing="6.0" style="-fx-background-color: #eff6ff; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #bfdbfe; -fx-border-radius: 6;">
                        <Label text="💡 กฎระเบียบสมาชิก:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;" />
                        <Label text="• ผู้จองสนามต้องเป็นสมาชิกเท่านั้น" style="-fx-font-size: 12px; -fx-text-fill: #1e3a8a;" />
                        <Label text="• จองครบ 19 ชม. ชั่วโมงที่ 20 ลด 30%" style="-fx-font-size: 12px; -fx-text-fill: #1e3a8a;" />
                        <Label text="• สามารถซื้อแพ็กเกจ 15 ชม. ราคา 2,600 บาทได้ตลอดเวลา" style="-fx-font-size: 12px; -fx-text-fill: #1e3a8a;" />
                    </VBox>
                </VBox>

                <!-- ขวา: ตารางรายชื่อสมาชิก และปุ่มจัดการ -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="🔍 ค้นหาสมาชิก:" style="-fx-font-weight: bold;" />
                        <TextField fx:id="searchMemberTextField" prefWidth="280.0" promptText="พิมพ์รหัส, ชื่อ หรือเบอร์โทรศัพท์..." />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="* สิทธิ์ Admin เท่านั้นที่สามารถลบสมาชิกได้" style="-fx-font-size: 11px; -fx-text-fill: #dc2626;" />
                    </HBox>

                    <!-- ตารางสมาชิก -->
                    <TableView fx:id="memberTableView" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMemberId" prefWidth="85.0" text="รหัสสมาชิก" />
                            <TableColumn fx:id="colMemberName" prefWidth="160.0" text="ชื่อ-นามสกุล" />
                            <TableColumn fx:id="colMemberPhone" prefWidth="120.0" text="เบอร์โทร" />
                            <TableColumn fx:id="colMemberAccumulated" prefWidth="80.0" text="สะสม (ชม.)" />
                            <TableColumn fx:id="colMemberPackage" prefWidth="90.0" text="แพ็กเกจคงเหลือ" />
                            <TableColumn fx:id="colMemberRegDate" prefWidth="100.0" text="วันที่สมัคร" />
                            <TableColumn fx:id="colMemberDiscountStatus" prefWidth="160.0" text="สถานะสิทธิ์ลด 30%" />
                        </columns>
                    </TableView>

                    <!-- แถบปุ่มจัดการสมาชิก -->
                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Button fx:id="selectMemberForBillingButton" onAction="#onSelectMemberForBilling"
                                text="⚡ เลือกสมาชิกไปคิดเงิน"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;" />
                        <Button fx:id="topUpPackageButton" onAction="#onTopUpPackageForSelectedMember"
                                text="🎟️ ซื้อแพ็กเกจ 15 ชม. (2,600 บ.)"
                                style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold;" />
                        <Button fx:id="viewMemberBookingHistoryButton" onAction="#onViewMemberBookingHistory"
                                text="📜 ดูประวัติการจอง (Admin)"
                                style="-fx-background-color: #7c3aed; -fx-text-fill: white; -fx-font-weight: bold;" />
                        <Button fx:id="editMemberButton" onAction="#onEditSelectedMember"
                                text="✏️ แก้ไขข้อมูล"
                                style="-fx-background-color: #eab308; -fx-text-fill: black; -fx-font-weight: bold;" />
                        <Button fx:id="deleteMemberButton" onAction="#onDeleteSelectedMember"
                                text="🗑️ ลบสมาชิก (Admin Only)"
                                style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold;" />
                    </HBox>
                </VBox>

            </HBox>
        </Tab>

        <!-- ======================================================== -->
        <!-- TAB 3: ประวัติบิลและการแนบสลิป -->
        <!-- ======================================================== -->
        <Tab fx:id="historyTab" text=" 📋 ประวัติการจองและบิล (History) ">
            <HBox spacing="15.0" style="-fx-padding: 15;">
                <VBox prefWidth="550.0" spacing="10.0">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="รายการบิลที่บันทึกไว้ในระบบ" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="searchBillTextField" prefWidth="220.0" promptText="🔍 ค้นหาเลขที่บิล, ชื่อสมาชิก..." />
                    </HBox>
                    <TableView fx:id="historyTableView" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colHistoryBillId" prefWidth="110.0" text="เลขที่บิล" />
                            <TableColumn fx:id="colHistoryDate" prefWidth="130.0" text="วันที่-เวลา" />
                            <TableColumn fx:id="colHistoryMember" prefWidth="130.0" text="สมาชิก/ลูกค้า" />
                            <TableColumn fx:id="colHistoryTotal" prefWidth="90.0" text="ยอดรวม" />
                            <TableColumn fx:id="colHistorySlip" prefWidth="80.0" text="สถานะสลิป" />
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="ใบเสร็จรับเงิน (Receipt Preview)" />
                    <TextArea fx:id="receiptPreviewTextArea" editable="false"
                              style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 12px;"
                              VBox.vgrow="ALWAYS" />
                </VBox>
            </HBox>
        </Tab>

        <!-- ======================================================== -->
        <!-- TAB 4: ผู้ดูแลระบบ & สรุปรายได้ (Admin Reports & Booking History) -->
        <!-- ======================================================== -->
        <Tab fx:id="adminTab" text=" 📊 ผู้ดูแลระบบ &amp; ประวัติการจอง (Admin Panel) ">
            <StackPane>
                <!-- ป้ายเตือนหากสิทธิ์ไม่พอ -->
                <Label fx:id="adminAccessDeniedLabel" visible="false"
                       style="-fx-font-size: 16px; -fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-background-color: #fee2e2; -fx-padding: 30; -fx-background-radius: 8;"
                       text="🔒 สิทธิ์ไม่เพียงพอ: ส่วนนี้จำกัดเฉพาะผู้ดูแลระบบ [ADMIN] เท่านั้น&#10;กรุณาสลับผู้ใช้ด้านบนเป็น [ADMIN] เพื่อดูข้อมูลสรุปรายได้และประวัติการจองของสมาชิก" />

                <!-- คอนเทนเนอร์รายงานการเงินและประวัติการจองสำหรับ Admin -->
                <VBox fx:id="adminReportContainer" spacing="12.0" style="-fx-padding: 15;">
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="เลือกวันที่ตรวจสอบรายได้:" />
                        <DatePicker fx:id="revenueDatePicker" />
                    </HBox>

                    <HBox spacing="15.0">
                        <!-- รายได้ประจำวัน -->
                        <VBox prefWidth="340.0" spacing="6.0"
                              style="-fx-background-color: #eff6ff; -fx-padding: 12 16 12 16; -fx-background-radius: 8; -fx-border-color: #bfdbfe; -fx-border-radius: 8;">
                            <Label style="-fx-text-fill: #1d4ed8; -fx-font-size: 13px; -fx-font-weight: bold;" text="รายได้ประจำวันที่เลือก (Daily)" />
                            <Label fx:id="dailyRevenueLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;" text="0.00 บาท" />
                        </VBox>

                        <!-- รายได้ประจำเดือน -->
                        <VBox prefWidth="340.0" spacing="6.0"
                              style="-fx-background-color: #f0fdf4; -fx-padding: 12 16 12 16; -fx-background-radius: 8; -fx-border-color: #bbf7d0; -fx-border-radius: 8;">
                            <Label style="-fx-text-fill: #15803d; -fx-font-size: 13px; -fx-font-weight: bold;" text="รายได้ประจำเดือนที่เลือก (Monthly)" />
                            <Label fx:id="monthlyRevenueLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #14532d;" text="0.00 บาท" />
                        </VBox>

                        <!-- รายได้สะสมทั้งหมด -->
                        <VBox prefWidth="340.0" spacing="6.0"
                              style="-fx-background-color: #fefce8; -fx-padding: 12 16 12 16; -fx-background-radius: 8; -fx-border-color: #fef08a; -fx-border-radius: 8;">
                            <Label style="-fx-text-fill: #a16207; -fx-font-size: 13px; -fx-font-weight: bold;" text="รายได้สะสมทั้งหมด (Total All-time)" />
                            <Label fx:id="totalRevenueLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #713f12;" text="0.00 บาท" />
                        </VBox>
                    </HBox>

                    <Separator />

                    <!-- Section: ประวัติการจองสนามของสมาชิก (Admin View) -->
                    <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label text="🏸 ประวัติการจองสนามของสมาชิก (Member Court Booking History):"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="กรองตามสมาชิก:" style="-fx-font-weight: bold;" />
                            <ComboBox fx:id="adminMemberFilterComboBox" prefWidth="260.0" promptText="-- ทั้งหมด / เลือกรหัสสมาชิก --" />
                            <Button onAction="#onRefreshAdminBookingHistory" text="🔄 รีเฟรช"
                                    style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold;" />
                        </HBox>

                        <HBox spacing="12.0" VBox.vgrow="ALWAYS">
                            <!-- ตารางประวัติการจองของสมาชิก -->
                            <TableView fx:id="adminBookingTableView" VBox.vgrow="ALWAYS" prefWidth="680.0">
                                <columns>
                                    <TableColumn fx:id="colAdminBookBillId" prefWidth="95.0" text="เลขที่บิล" />
                                    <TableColumn fx:id="colAdminBookDate" prefWidth="125.0" text="วันที่-เวลา" />
                                    <TableColumn fx:id="colAdminBookMember" prefWidth="130.0" text="สมาชิก" />
                                    <TableColumn fx:id="colAdminBookDetails" prefWidth="190.0" text="สนาม / ช่วงเวลาที่จอง" />
                                    <TableColumn fx:id="colAdminBookHours" prefWidth="55.0" text="ชม." />
                                    <TableColumn fx:id="colAdminBookTotal" prefWidth="80.0" text="ยอดชำระ" />
                                    <TableColumn fx:id="colAdminBookSlip" prefWidth="75.0" text="สลิป" />
                                </columns>
                            </TableView>

                            <!-- พรีวิวรายละเอียดบิลการจอง -->
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS" prefWidth="380.0">
                                <Label text="📄 รายละเอียดการจอง &amp; ใบเสร็จรับเงิน:" style="-fx-font-weight: bold;" />
                                <TextArea fx:id="adminBookingReceiptTextArea" editable="false"
                                          style="-fx-font-family: 'Courier New', monospace; -fx-font-size: 11px;"
                                          VBox.vgrow="ALWAYS" />
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>
            </StackPane>
        </Tab>

    </TabPane>

</VBox>
